{
  "name": "pipette-ui",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "check": "svelte-check --tsconfig ./tsconfig.json --fail-on-warnings --tsgo",
    "test": "vitest run",
    "types": "json2ts -i src/lib/api-schema.json -o src/lib/api-types.ts --unreachableDefinitions --additionalProperties false --bannerComment '// Generated from api-schema.json (pipette_httpapi::api_schema) by `npm run types`. Do not edit.'"
  },
  "devDependencies": {
    "@sveltejs/vite-plugin-svelte": "^7.3.1",
    "@tsconfig/svelte": "^5.0.8",
    "@typescript/native": "npm:typescript@^7.0.2",
    "json-schema-to-typescript": "^16.0.0",
    "svelte": "^5.57.1",
    "svelte-check": "^4.7.6",
    "typescript": "^6.0.3",
    "vite": "^8.3.4",
    "vitest": "^5.0.3"
  }
}
